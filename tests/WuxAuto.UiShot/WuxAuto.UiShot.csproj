    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WuxAuto.UiShot</AssemblyName>
    <StartupObject>WuxAuto.UiShot.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WuxAuto\WuxAuto.csproj" />
  </ItemGroup>

</Project>
