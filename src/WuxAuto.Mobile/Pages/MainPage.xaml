<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WuxAuto.Mobile.Pages.MainPage"
             Title="Pilot">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">
            <Label Text="WuxAuto" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="ServiceHint" TextColor="#C62828" IsVisible="False"
                   Text="The accessibility service is off: open the Setup page first." />

            <Label Text="Mode" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="16" RadioButtonGroup.GroupName="mode">
                <RadioButton x:Name="ModeLod" Content="LOD" CheckedChanged="OnModeChanged" />
                <RadioButton x:Name="ModeLaby" Content="Laby: coming in M5" IsEnabled="False" />
            </HorizontalStackLayout>
            <Label FontSize="12" TextColor="Gray"
                   Text="LOD for now fights where the teleport lands: it does not walk to the boss yet (no picture of the LOD minimap's south beam on the phone). When the LOD entries run out it stops in town." />

            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="DryRun" CheckedChanged="OnDryRunChanged" />
                <Label Text="Dry run (detect only, no touches)" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="StartButton" Text="Start" Clicked="OnStart" />
                <Button Grid.Column="1" Text="Stop" Clicked="OnStop" />
                <Button Grid.Column="2" Text="Panic" BackgroundColor="#C62828" Clicked="OnPanic" />
            </Grid>
            <Label FontSize="12" TextColor="Gray"
                   Text="Start asks for screen capture once per session and brings the game back. In the game, the round W button is the control: tap = panel, long-press = stop at once." />
            <Label FontSize="12" TextColor="Gray"
                   Text="Every Start checks the shortcut ring round the joystick: the first Start adds Teleport Scroll and Pick up (and AUTO BUFF) to free (+) slots if they are missing - it never replaces a filled slot; with no free slot left it stops and says what to add." />

            <Label Text="Status" FontAttributes="Bold" />
            <Border Padding="8" StrokeThickness="1" Stroke="#3A4458">
                <Label x:Name="Status" MaxLines="3" LineBreakMode="TailTruncation" HeightRequest="60" />
            </Border>
            <Label x:Name="LastKill" FontSize="13" />
            <Label x:Name="Capture" FontSize="13" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Stop screen capture" Clicked="OnStopCapture" />
                <Button Grid.Column="1" Text="Send debug bundle" Clicked="OnDebugBundle" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
