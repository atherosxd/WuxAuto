<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>WuxAuto.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>WuxAuto</ApplicationTitle>
    <ApplicationId>io.github.atherosxd.wuxauto</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == ''">C:\Program Files\Android\openjdk\jdk-21.0.8</JavaSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == ''">C:\Program Files (x86)\Android\android-sdk</AndroidSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WuxAuto.Core\WuxAuto.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="Emgu.CV" Version="5.0.0.6584" />
    <PackageReference Include="Emgu.CV.runtime.maui.mini.android" Version="5.0.0.6584" />
    <!-- The bundled Latin model (com.google.mlkit:text-recognition): no Play Services download. -->
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
    <!-- Fragment 1.9 absorbed fragment-ktx; the 1.8.x Ktx package that MAUI/ML Kit pull in duplicates its classes (R8 "defined multiple times"). Pin the 1.9 stub. -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
    <!-- MAUI pulls LiveData.Core 2.11 but LiveData / LiveData.Core.Ktx 2.9 (NU1608): keep the family on one version. -->
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Packed into the APK as assets/phone/* and assets/shared/*; AssetInstaller copies both, flat, into the
         external files dir (TemplateLibrary reads only the top folder). The desktop templates are shared as they are. -->
    <MauiAsset Include="Assets\phone\*.png" LogicalName="phone\%(Filename)%(Extension)" />
    <MauiAsset Include="..\WuxAuto\Assets\*.png" LogicalName="shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
