<Window x:Class="WuxAuto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WuxAuto.ViewModels"
        xmlns:core="clr-namespace:WuxAuto.Core;assembly=WuxAuto.Core"
        xmlns:auto="clr-namespace:WuxAuto.Automation;assembly=WuxAuto.Core"
        xmlns:conv="clr-namespace:WuxAuto.Converters"
        Title="WuxAuto - Wuxen2 pilot"
        Icon="WuxAuto.ico"
        Height="880" Width="1380"
        MinHeight="500" MinWidth="760"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:LogLevelBrushConverter x:Key="LogLevelBrush" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= controls ================= -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
            <StackPanel>

                <TextBlock Text="WuxAuto" FontSize="24" FontWeight="SemiBold" />
                <!-- version + updates (GitHub Releases) -->
                <DockPanel Margin="0,6,0,12" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding VersionText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Left" Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Margin="10,0,0,0" />
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="4,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Border Background="#10301E" BorderBrush="#2E8A57" BorderThickness="1" CornerRadius="8"
                        Padding="10,6" Margin="0,-4,0,12"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Install now" Style="{StaticResource PrimaryButton}"
                                Command="{Binding InstallUpdateCommand}" Margin="8,0,0,0" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#8FE3B0"
                                   Text="{Binding AvailableUpdate.VersionText, StringFormat='Update v{0} is available. WuxAuto closes, updates and reopens itself.'}" />
                    </DockPanel>
                </Border>

                <!-- recommended in-game settings -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Recommended game settings" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Margin" Value="0,2,0,2" />
                                </Style>
                            </Grid.Resources>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Resolution" Style="{StaticResource FieldLabel}" Margin="0,2,12,2" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Any (tested best at 1024 x 768)" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Display mode" Style="{StaticResource FieldLabel}" Margin="0,2,12,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Windowed (optimized for it)" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Interface scale" Style="{StaticResource FieldLabel}" Margin="0,2,12,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Auto  (Settings ▸ Visual)" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Font size" Style="{StaticResource FieldLabel}" Margin="0,2,12,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="110 - 120 %  (Settings ▸ Visual)" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Tab target" Style="{StaticResource FieldLabel}" Margin="0,2,12,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Default (Laby/LOD); Enemy worth CP in Auto War (set by the pilot)  (Settings ▸ Visual)" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- bind -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="1. Bind the game window" Style="{StaticResource SectionTitle}" />
                        <ComboBox ItemsSource="{Binding Windows}"
                                  SelectedItem="{Binding SelectedWindow}"
                                  MaxDropDownHeight="320">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                            <Button Content="Refresh list" Command="{Binding RefreshWindowsCommand}" />
                            <Button Content="Bind / Unbind" Command="{Binding BindCommand}" />
                            <Button Content="Focus game" Command="{Binding FocusGameCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding BindStatus}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <!-- run -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="2. Run the teleport sequence" Style="{StaticResource SectionTitle}" />
                        <!-- Four modes no longer fit one row of the left panel: the buttons wrap (Grid, so the WrapPanel gets a width). -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"
                                        IsEnabled="{Binding IsRunning, Converter={x:Static vm:BoolConverters.Inverse}}">
                                <RadioButton GroupName="RunMode" Content="Auto Laby" Style="{StaticResource ModeButton}"
                                             IsChecked="{Binding Settings.Sequence.Mode, Converter={x:Static vm:BoolConverters.EnumEquals}, ConverterParameter=AutoLaby}"
                                             ToolTip="The Labyrinth (Adept): 4 stages + Sacred Sky Lord, back to town, repeat." />
                                <RadioButton GroupName="RunMode" Content="Auto LOD" Style="{StaticResource ModeButton}"
                                             IsChecked="{Binding Settings.Sequence.Mode, Converter={x:Static vm:BoolConverters.EnumEquals}, ConverterParameter=AutoLod}"
                                             ToolTip="Ultimate Den of Rebirth: Bai Gu Great, respawns - fights until the map timer runs out." />
                                <RadioButton GroupName="RunMode" Content="Auto War" Style="{StaticResource ModeButton}"
                                             IsChecked="{Binding Settings.Sequence.Mode, Converter={x:Static vm:BoolConverters.EnumEquals}, ConverterParameter=AutoWar}"
                                             ToolTip="Bohai Outpost war: wait in a page-3 cave, join every war, fight, come back to the same cave and monster." />
                                <RadioButton GroupName="RunMode" Content="Auto Blossom" Style="{StaticResource ModeButton}"
                                             IsChecked="{Binding Settings.Sequence.Mode, Converter={x:Static vm:BoolConverters.EnumEquals}, ConverterParameter=AutoBlossom}"
                                             ToolTip="Blossom Garden: line up on the two pillars, walk the 83-waypoint route there and back, kill and loot every Jaso Practitioner, rebuff on the Auto War timer." />
                            </WrapPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="▶  Start" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"
                                    IsEnabled="{Binding IsRunning, Converter={x:Static vm:BoolConverters.Inverse}}" />
                            <Button Content="■  Stop" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" />
                            <Button Content="▭  Mini" Click="OnMiniMode"
                                    ToolTip="Small always-on-top window with the mode, Start and Stop." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,4"
                                   Text="F9 toggles start/stop from inside the game, F10 panics (stops and unbinds)." />
                        <Border Background="#3A2A10" BorderBrush="#8A6212" BorderThickness="1" CornerRadius="8"
                                Padding="10,6" Margin="0,0,0,8"
                                Visibility="{Binding Settings.Sequence.DryRun, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock TextWrapping="Wrap" Foreground="#FFC46B"
                                       Text="Dry run is ON - the pilot detects and logs, but sends no keys or clicks to the game." />
                        </Border>
                        <WrapPanel>
                            <CheckBox Content="Dry run (no input)" IsChecked="{Binding Settings.Sequence.DryRun}" />
                            <CheckBox Content="Loop" IsChecked="{Binding Settings.Sequence.Loop}" />
                            <CheckBox Content="Restart on error" IsChecked="{Binding Settings.Sequence.RestartOnError}"
                                      ToolTip="After an error start over from the top instead of stopping (at most 5 times in 30 minutes)." />
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox Content="Kill chime" IsChecked="{Binding Settings.Sequence.KillChime}" VerticalAlignment="Center"
                                      ToolTip="A chime on this PC when a Labyrinth boss dies (every stage) and when an LOD kill's loot step ends - a reminder to check the loot. 'Choose...' below picks your own MP3, WAV or OGG." />
                            <CheckBox Content="Kill notification" IsChecked="{Binding Settings.Sequence.KillNotification}" VerticalAlignment="Center"
                                      ToolTip="A Windows notification at the same moments (it stays in the notification centre). Windows may hold it back while a game is in front." />
                            <Button Content="Test alert" Command="{Binding TestKillAlertCommand}" Padding="10,4"
                                    ToolTip="Plays the chime and shows the notification now (whichever is ticked), to check the sound on this PC." />
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="Sound:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding KillSoundName}" ToolTip="{Binding KillSoundPath}" VerticalAlignment="Center"
                                       MaxWidth="160" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                            <Button Content="Choose..." Command="{Binding ChooseKillSoundCommand}" Padding="10,4"
                                    ToolTip="Pick an MP3, WAV or OGG file for the kill chime. It is copied into WuxAuto's sounds folder (so it keeps playing if you move the original; an OGG is kept as a WAV) and played once." />
                            <Button Content="Default" Command="{Binding ResetKillSoundCommand}" Padding="10,4"
                                    Visibility="{Binding HasKillSound, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Back to the built-in chime." />
                        </WrapPanel>
                        <Border Background="#0E1118" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding StateText}" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LastKillText, StringFormat='Last kill: {0}'}" Foreground="{StaticResource Success}" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding LastKillText, Converter={x:Static vm:BoolConverters.NotEmptyToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- vision debug -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="3. Verify detection" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Test scan now" Command="{Binding TestScanCommand}" />
                            <Button Content="Reload templates" Command="{Binding ReloadTemplatesCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding OcrStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Debug snapshots" Command="{Binding OpenDebugFolderCommand}" />
                            <Button Content="Kill screenshots" Command="{Binding OpenKillsFolderCommand}"
                                    ToolTip="A screenshot when a boss dies and one when the pilot moves on (after the loot), to check whether the drops were picked up." />
                            <Button Content="Templates folder" Command="{Binding OpenTemplatesFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- settings -->
                <Expander Header="Settings (applied live, saved on exit)">
                    <StackPanel Margin="0,8,0,0">

                        <TextBlock Text="Input" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Inventory key" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Input.InventoryKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Rotate key" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Input.RotateKey, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Reverse key" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Input.RotateKeyReverse, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Mode" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,8,6"
                                      ItemsSource="{Binding Source={x:Static vm:OptionLists.InputModes}}"
                                      SelectedItem="{Binding Settings.Input.Mode}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Key hold ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Input.KeyHoldMs}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Post-click ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Input.AfterClickMs}" />

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                                <CheckBox Content="Only while game is focused" IsChecked="{Binding Settings.Input.RequireForeground}" />
                                <CheckBox Content="Focus on start" IsChecked="{Binding Settings.Input.FocusOnStart}" />
                                <CheckBox Content="Restore cursor" IsChecked="{Binding Settings.Input.RestoreCursor}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Detection" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Icon score" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Detection.TemplateThreshold}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Compass score" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Detection.CompassThreshold}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="North tolerance°" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Detection.CompassToleranceDeg}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="OCR scale" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Detection.OcrScale}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Compass mode" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,6"
                                      ItemsSource="{Binding Source={x:Static vm:OptionLists.CompassModes}}"
                                      SelectedItem="{Binding Settings.Detection.CompassMode}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Rotation" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,0,8,6"
                                      ItemsSource="{Binding Source={x:Static vm:OptionLists.RotationModes}}"
                                      SelectedItem="{Binding Settings.Sequence.RotationMode}" />
                        </Grid>

                        <TextBlock Text="Sequence" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Destination" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Sequence.DestinationText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Retries" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Sequence.MaxRetries}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Load min ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Sequence.LoadingMinMs}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Settle ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Sequence.LoadingSettleMs}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Gate mode" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,6"
                                      ItemsSource="{Binding Source={x:Static vm:OptionLists.GateModes}}"
                                      SelectedItem="{Binding Settings.Sequence.GateMode}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Gate delay ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Sequence.GateDelayMs}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Gate text" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Sequence.GateText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Loop delay ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="3" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Sequence.LoopDelayMs}" />
                        </Grid>

                        <TextBlock Text="Dungeon" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Skill key" Style="{StaticResource FieldLabel}"
                                       ToolTip="Pressed on the targeted last boss: the character walks there and attacks (1 = the top-row 1 key)." />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Dungeon.SkillKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Autohunt key" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Dungeon.AutohuntKey, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Target key" Style="{StaticResource FieldLabel}"
                                       ToolTip="Shows the boss name and marker (Tab)." />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Dungeon.TabKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Font size %" Style="{StaticResource FieldLabel}"
                                       ToolTip="Checked in the game's Settings > VISUAL on Start in town: inside min - max it is left alone, outside it is moved to the nearer end. Min 0 = leave it alone." />
                            <Grid Grid.Row="1" Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource Field}" Margin="0,0,4,6" ToolTip="Min"
                                         Text="{Binding Settings.Sequence.FontSizePercent}" />
                                <TextBlock Grid.Column="1" Text="-" Style="{StaticResource FieldLabel}" Margin="0,0,4,6" />
                                <TextBox Grid.Column="2" Style="{StaticResource WideField}" ToolTip="Max"
                                         Text="{Binding Settings.Sequence.FontSizeMaxPercent}" />
                            </Grid>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Buff key (LOD)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Auto LOD: auto-buff on arrival and every 4 min 50 s (most buffs last 5 min). Empty = off." />
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Lod.BuffKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Laby key wait (s)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Labyrinth teleport clicked but still in town: wait this many seconds after it, then count it as out of Temple of Fiends Keys and switch to Auto LOD." />
                            <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Sequence.LabyKeyWaitSeconds}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Manual attacks" Style="{StaticResource FieldLabel}"
                                       ToolTip="Laby, stage 5: with the boss in view, hold the skill key (see Hold skill), then tap it this many times (300 ms or more apart, see Attack gap); the autohunt only goes on after a new 'Attack succeeded' line. 0 = autohunt straight away." />
                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Dungeon.ManualAttacks}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Shura key (LOD)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Auto LOD: Shura stops the attack before a mid-fight buff and before the walk up to the boss. Its icon (shura.png) is clicked on the skill bar; when it is not found this key is tapped instead (the slot you put Shura in, default E). Empty = Space when the icon is not found. Auto War: held at the start of every fight cycle; empty = no Shura hold." />
                            <TextBox Grid.Row="3" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Lod.ShuraKey, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Run key" Style="{StaticResource FieldLabel}"
                                       ToolTip="In town, before every teleport: the Run skill must be on (a gold ring round its icon). Its icon (runskill.png) is found on the skill bar and clicked when the ring is missing; when the icon is not found this key is tapped once per Start instead (the slot you put Run in, default W). Empty = only the icon." />
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Sequence.RunSkillKey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Attack gap (ms)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Laby, stage 5: at least this long between two skill presses on the boss (default 300 ms)." />
                            <TextBox Grid.Row="4" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Dungeon.ManualAttackIntervalMs}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Hold skill (ms)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Laby: on stage 5 the first attack on the boss holds the skill key down this long (the character runs at the boss and keeps attacking), then the Manual attacks taps follow; on stages 1-4 the same hold comes before the autohunt (see the check box). 0 = no hold." />
                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Dungeon.HoldSkillMs}" />

                            <WrapPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4">
                                <CheckBox Content="Tab + skill at the last waypoint" IsChecked="{Binding Settings.Dungeon.TabAtWaypoint}"
                                          ToolTip="At 3603,1973: Tab until the last boss shows, then spam the skill key. Off = walk to the boss coordinates." />
                                <CheckBox Content="Autohunt off for the run" IsChecked="{Binding Settings.Dungeon.FinalBossPressAutohunt}"
                                          ToolTip="Autohunt off after stage 4, on again at the last boss." />
                                <CheckBox Content="Ctrl + skill key too" IsChecked="{Binding Settings.Dungeon.CtrlSkill}"
                                          ToolTip="Manual attacks (Laby stage 5 and the LOD skill spam): every skill press sends the skill key and then Ctrl + skill key, e.g. 1 then Ctrl+1. With Hold skill (LOD) the held key is let go for a Ctrl + skill tap every 0.3 s." />
                                <CheckBox Content="Hold skill before autohunt (stages 1-4)" IsChecked="{Binding Settings.Dungeon.HoldBeforeAutohunt}"
                                          ToolTip="Laby, stages 1-4: with the boss in view, hold the skill key (Hold skill) once before the autohunt goes on, then J and the select clicks. Off = J right after the spawn wait, as before." />
                            </WrapPanel>
                            <WrapPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4">
                                <CheckBox Content="Click the stage 5 gate" IsChecked="{Binding Settings.Dungeon.AimGate}"
                                          ToolTip="Tilt the camera if needed and click the red/orange gate after stage 4." />
                                <CheckBox Content="Auto reconnect" IsChecked="{Binding Settings.Sequence.AutoReconnect}"
                                          ToolTip="Log back in after a disconnect (the game must remember the account)." />
                                <CheckBox Content="Hold skill (LOD)" IsChecked="{Binding Settings.Lod.HoldSkill}"
                                          ToolTip="Auto LOD: hold the skill key down while attacking instead of spamming it." />
                                <CheckBox Content="Walk up to the boss (LOD)" IsChecked="{Binding Settings.Lod.ApproachBoss}"
                                          ToolTip="Auto LOD: after the first hit, stop attacking (Shura, else Space) and Ctrl+click the pink ring round the boss's feet, then attack again. After that the ring is checked every 3 s: the character off it -> Shura and Ctrl+click it again." />
                                <CheckBox Content="Walk to the boss spot (LOD)" IsChecked="{Binding Settings.Lod.WalkToBossSpot}"
                                          ToolTip="Auto LOD: after the south turn, walk forward to 1199,1782 pressing Tab and wait there until the boss shows. Off = stay where the teleport put the character and press Tab." />
                                <CheckBox Content="TAB target: Default" IsChecked="{Binding Settings.Sequence.TabTargetDefault}"
                                          ToolTip="On Start in town, with the font size: the game's Settings > VISUAL > TAB target is set to Default and saved." />
                                <CheckBox Content="Autohunt off in town" IsChecked="{Binding Settings.Sequence.AutohuntOffInTown}"
                                          ToolTip="In town, before every teleport: tap the autohunt key and read the combat log ('Auto hunt started' / 'ended'); turn it off if it was on." />
                                <CheckBox Content="Run skill on in town" IsChecked="{Binding Settings.Sequence.RunSkillCheck}"
                                          ToolTip="In town, before every teleport: find the Run skill icon on the skill bar and click it when it has no ring (= not active); icon not found -> the Run key once per Start." />
                                <CheckBox Content="Regular War off before Laby" IsChecked="{Binding Settings.Sequence.RegularWarOffForLaby}"
                                          ToolTip="Auto Laby, in town before the first teleport of a Start: open the autohunt settings (S) and untick 'Regular War', so the autohunt cannot take the character to a war while it fights a boss. Unreadable -> a warning, the run carries on." />
                                <CheckBox Content="Auto confirm (Ctrl + right click)" IsChecked="{Binding Settings.Sequence.AutoConfirmDialogs}"
                                          ToolTip="While the game is bound and the pilot is not running: after a Ctrl + right click on the game (selling / using items) the '... Confirm to ...?' dialog's OK is clicked the moment it shows (about 0.2 s). A plain right click leaves the dialog alone." />
                            </WrapPanel>
                        </Grid>

                        <TextBlock Text="Auto War" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Shura hold (ms)" Style="{StaticResource FieldLabel}"
                                       ToolTip="How long the Shura key (LOD) is held at the start of each fight cycle, before the skill taps. No Shura key = no hold." />
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.War.ShuraHoldMs}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Rebuff every (ms)" Style="{StaticResource FieldLabel}"
                                       ToolTip="How often the war buffs are renewed while the war runs (5 min 45 s = 345000): the buff key with autobuff, else the ticked buff icons; the ticked item buffs either way." />
                            <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.War.BuffEveryMs}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Lead time (ms)" Style="{StaticResource FieldLabel}"
                                       ToolTip="How long before the war opens the autohunt is turned off and the pilot starts waiting for the war dialog (10 s = 10000)." />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.War.LeadMs}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="TAB target" Style="{StaticResource FieldLabel}"
                                       ToolTip="The game's Settings > VISUAL > TAB target value the war needs; it is set when the pilot enters Bohai and left as is afterwards." />
                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="190" Margin="0,0,0,6" VerticalAlignment="Center"
                                      ItemsSource="{x:Static auto:TabTargetOptions.All}"
                                      SelectedItem="{Binding Settings.War.TabTargetOption}" />

                            <!-- Buffs (user, 2026-10-28): one check box per buff icon, unticked = never clicked, not looked for at Start. -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Text="Buffs" Style="{StaticResource FieldLabel}" Margin="0,2,6,2"
                                       ToolTip="Tick the buffs this character has on its skill bar. Unticked ones are never clicked and not looked for at Start; a ticked one that is not on the bar is only warned about." />
                            <ItemsControl Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,6" ItemsSource="{Binding WarBuffSwitches}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- Fixed slots so the boxes line up: two per row, each wide enough for "Weapon 1 (sword)" with its icon (~159 DIP). -->
                                        <WrapPanel ItemWidth="168" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:WarBuffSwitch}">
                                        <CheckBox IsChecked="{Binding IsOn}" ToolTip="{Binding ToolTip}" Margin="0,2,4,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,5,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource Caption}"
                                       Visibility="{Binding Settings.War.HomeMap, Converter={x:Static vm:BoolConverters.NotEmptyToVisibility}}"
                                       ToolTip="Read from the screen at Start, in the cave you wait in. It is where the pilot goes back to after the war. Start in a home town: the pilot waits in town instead.">
                                <Run Text="Back to: " /><Run Text="{Binding Settings.War.HomeMap, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding Settings.War.HomeMonster, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource Caption}"
                                       Text="Back to: (no cave - waits in town; press Start in a cave to save one)"
                                       Visibility="{Binding Settings.War.HomeMap, Converter={x:Static vm:BoolConverters.EmptyToVisibility}}"
                                       ToolTip="Read from the screen at Start, in the cave you wait in. It is where the pilot goes back to after the war. Start in a home town: the pilot waits in town instead." />
                        </Grid>

                        <!-- Auto Blossom (user, 2026-10-29). Waypoints, pillar score and the rest: settings.json (Blossom). The buffs are the Auto War ones above. -->
                        <TextBlock Text="Auto Blossom" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- User, 2026-10-30: "1 - 83 then 83, 82, 81 to 1 then loop". Record route ticks it when the route does not come back round. -->
                            <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0">
                                <CheckBox Content="Walk back the same way" Margin="0,0,16,0"
                                          IsChecked="{Binding Settings.Blossom.BackAndForth}"
                                          ToolTip="On: after the last waypoint the route is walked back (83, 82 ... to the loop start), then forward again, and the camera turns are undone on the way back. Off: from the last waypoint straight to the loop start. Record route ticks it when the recorded road does not come back to its start." />
                                <!-- User, 2026-10-30: "spam or hold attack skill, currently it skills then normal attacks". -->
                                <!-- User, 2026-10-30: "try looting also ... the 1s delay after killing is enough for the loot". -->
                                <CheckBox Content="Loot while fighting" Margin="0,0,16,0"
                                          IsChecked="{Binding Settings.Blossom.LootWhileFighting}"
                                          ToolTip="On: the loot key is tapped all through a fight, and the walk goes on as soon as the kill is seen (the target gone 1 s). Off: after the kill it waits 1 s, then loots for 'Loot time'." />
                                <CheckBox Content="Hold skill (Blossom)" Margin="0,0,16,0"
                                          IsChecked="{Binding Settings.Blossom.HoldSkill}"
                                          ToolTip="On: the skill key stays held down through a fight, so the skill keeps going instead of one cast followed by normal attacks (with 'Ctrl + skill key too' it is let go for a Ctrl + skill tap now and then). Off: the skill is tapped every 0.3 s." />
                            </WrapPanel>

                            <!-- User, 2026-10-29: "add a settings in the app just like you showed 1:5A". Applied on the next Start. -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Camera turns" Style="{StaticResource FieldLabel}"
                                       ToolTip="Camera turns when leaving a waypoint: waypoint:count+key, A = left, D = right, separated by commas. E.g. 1:5A, 2:5D, 3:5A, 4:5D = after waypoint 1 tap A five times, after waypoint 2 tap D five times... Used from the next Start." />
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource WideField}"
                                     Text="{Binding Settings.Blossom.WaypointTurnsText, UpdateSourceTrigger=LostFocus}" />

                            <!-- Record route (user, 2026-10-29): walk the road by hand, WuxAuto saves the waypoints and your A / D turns. -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding RecordRouteText}" Command="{Binding ToggleRecordRouteCommand}" Margin="0,0,6,0"
                                            ToolTip="Bind the game, stand at the start of the route (the arrival spot in Blossom Garden) and press this, then walk the road by hand. A waypoint is saved every 120 units, and your A / D camera taps are saved with the latest waypoint. Press it again to save the route (it replaces the waypoints, the loop start and the camera turns)." />
                                    <Button Content="Loop starts here" Command="{Binding MarkLoopStartCommand}"
                                            ToolTip="While recording: the waypoint here is where the route loops back to after the last one (like 17 -> 6). Not pressed: the whole route loops from waypoint 1." />
                                </StackPanel>
                                <TextBlock Text="{Binding RouteStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Target name" Style="{StaticResource FieldLabel}"
                                       ToolTip="The monster attacked when Tab selects it (the target bar). A target showing the chest counts too." />
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource WideField}" Text="{Binding Settings.Blossom.TargetName}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Waypoint pause (ms)" Style="{StaticResource FieldLabel}"
                                       ToolTip="How long the character stands at a reached waypoint, pressing Tab, before walking on. At most 5000 - the map's AFK checker kicks idle characters to town." />
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource WideField}" Text="{Binding Settings.Blossom.WaypointWaitMs}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Loot time (ms)" Style="{StaticResource FieldLabel}"
                                       ToolTip="Only with 'Loot while fighting' off: how long the loot key is spammed after a kill (every 0.2 s, starting 1 s after the kill). The buffs use the Auto War settings above." />
                            <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource WideField}" Text="{Binding Settings.Blossom.LootMs}" />
                        </Grid>

                        <TextBlock Text="Mini mode" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Position" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Width="160" HorizontalAlignment="Left" VerticalAlignment="Center" SelectedValuePath="Tag"
                                      SelectedValue="{Binding Settings.Ui.MiniPosition}"
                                      ToolTip="Where the mini window opens on the screen.">
                                <ComboBoxItem Content="Top Left" Tag="{x:Static core:MiniPosition.TopLeft}" />
                                <ComboBoxItem Content="Top Center" Tag="{x:Static core:MiniPosition.TopCenter}" />
                                <ComboBoxItem Content="Top Right" Tag="{x:Static core:MiniPosition.TopRight}" />
                                <ComboBoxItem Content="Middle Left" Tag="{x:Static core:MiniPosition.MiddleLeft}" />
                                <ComboBoxItem Content="Middle" Tag="{x:Static core:MiniPosition.Middle}" />
                                <ComboBoxItem Content="Middle Right" Tag="{x:Static core:MiniPosition.MiddleRight}" />
                                <ComboBoxItem Content="Bottom Left" Tag="{x:Static core:MiniPosition.BottomLeft}" />
                                <ComboBoxItem Content="Bottom Center" Tag="{x:Static core:MiniPosition.BottomCenter}" />
                                <ComboBoxItem Content="Bottom Right" Tag="{x:Static core:MiniPosition.BottomRight}" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="Screen positions" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Search regions and click positions are not saved. Every run rebuilds them from the built-in defaults for the current window size and re-learns the template scales, so the game can run at any resolution." />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SaveSettingsState}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ================= preview + log ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="240" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#05070B" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="6" />
                    <TextBlock Text="No capture yet" Foreground="#3C4658" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border VerticalAlignment="Bottom" Background="#CC05070B" Padding="10,6" CornerRadius="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewCaption}" Foreground="#B9C4D6" FontSize="11.5" />
                            <TextBlock Style="{StaticResource Caption}" Text="Keep this window away from the game area: capture always works, input only fires while the game is in front." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Log" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" />
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" Padding="8,3" />
                    </StackPanel>
                    <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogEntries}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:LogEntry}">
                                <TextBlock TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}">
                                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#6C7A90" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
