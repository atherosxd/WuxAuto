<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>WuxAuto.ico</ApplicationIcon>
    <AssemblyName>WuxAuto</AssemblyName>
    <RootNamespace>WuxAuto</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Process-scoped automation pilot for Wuxen2</Description>
    <!-- English UI only: keeps the self-contained package (publish.ps1) smaller. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Emgu CV's native runtime brings the MSVC runtime DLLs in packages that only have .NET
         Framework build targets (a native-file copy); their runtimes\win-x64\native files are
         used as they are, so NuGet's NU1701 fallback warning is expected. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WuxAuto.Core\WuxAuto.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- OpenCV for Core's vision: Emgu CV's native Windows build (brings the managed Emgu.CV too). -->
    <PackageReference Include="Emgu.CV.runtime.mini.windows" Version="5.0.0.6584" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window icon (the exe icon comes from ApplicationIcon). Built by branding\make_icon.py. -->
    <Resource Include="WuxAuto.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\*.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Diagnose.cmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
