<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WuxAuto</RootNamespace>
    <AssemblyName>WuxAuto.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Managed Emgu CV only; each host adds its native runtime (desktop: Emgu.CV.runtime.mini.windows). -->
    <PackageReference Include="Emgu.CV" Version="5.0.0.6584" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WuxAuto" />
    <InternalsVisibleTo Include="WuxAuto.SelfTest" />
    <InternalsVisibleTo Include="WuxAuto.Core.Tests" />
  </ItemGroup>

</Project>
