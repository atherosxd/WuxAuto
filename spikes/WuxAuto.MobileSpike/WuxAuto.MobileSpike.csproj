<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>WuxAuto.MobileSpike</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>WuxSpike</ApplicationTitle>
    <ApplicationId>io.github.atherosxd.wuxauto.spike</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>31</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == ''">C:\Program Files\Android\openjdk\jdk-21.0.8</JavaSdkDirectory>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == ''">C:\Program Files (x86)\Android\android-sdk</AndroidSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Emgu.CV" Version="5.0.0.6584" />
    <PackageReference Include="Emgu.CV.runtime.maui.mini.android" Version="5.0.0.6584" />
    <PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.9" />
    <!-- Fragment 1.9 absorbed fragment-ktx; the 1.8.x Ktx package that MAUI/ML Kit pull in duplicates its classes (R8 "defined multiple times"). Pin the 1.9 stub. -->
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
  </ItemGroup>
</Project>
